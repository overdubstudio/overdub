node_modules/
tools/.out/
.DS_Store
*.log
.claude/worktrees/

# Raw footage for the launch film (lives in ~/Movies/Overdub)
*.mov
*.MOV

# Deploy ids for this account (deploy/env.example lists them; setup.sh writes .distribution-id)
deploy/.env
deploy/.distribution-id

# The preview site's distribution id (terraform -chdir=infra/next output -raw distribution_id; ci.yml writes it)
deploy/.next-distribution-id

# The deploy's switches (deploy/deploy.sh writes app/site-config.json from deploy/site-config.json, else {}), never committed
app/site-config.json
deploy/site-config.json

# Sampled kits (kernel data): built by node tools/fetch-kits.js, uploaded by deploy/deploy.sh, never committed
app/kits/

# The community shelf's bundled snapshot: node tools/community-pull.js fills it from overdub-devices at deploy/community-pin.json
app/community/

# Model weights and ONNX Runtime builds for the stems runner (spec 0014 R29): fetched at run time from the URLs in
# app/site-config.json, never committed
*.onnx
*.ort
*.safetensors
*.pt
*.th
onnxruntime-web/

# The stems runner's runtime and model, staged on the site (deploy/stage-stems.js writes them into the deploy's stage,
# never the checkout; a local copy here is served by server/serve.js) and the deploy's download cache: never committed
app/vendor/ort/
app/vendor/models/
deploy/.cache/

# Terraform (infra/): provider caches, state, plans and crash logs are never committed; .terraform.lock.hcl is
infra/**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.auto.tfvars
